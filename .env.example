# WIREFRAME deployment settings. Copy to .env (never commit .env). Analysis parameters live in config/wireframe.yaml.
WIREFRAME_DATA_DIR=var                     # database, uploads, renders, reports, backups
# WIREFRAME_DATABASE_URL=sqlite:///var/wireframe.db
WIREFRAME_MAX_UPLOAD_MB=64
WIREFRAME_PUBLIC_UPLOADS_PER_WINDOW=20     # anonymous uploads per client per 15 minutes
WIREFRAME_COOKIE_SECURE=0                  # 1 behind HTTPS
WIREFRAME_LOG_LEVEL=INFO
# WIREFRAME_AUTO_DOWNLOAD=1                # 0: never download model weights (copy them into models/ by hand)
# WIREFRAME_WEIGHTS_BASE_URL=              # alternative mirror for the model-weights branch
# WIREFRAME Assistant. auto: Claude when ANTHROPIC_API_KEY is set in the server environment, else documentation only.
# WIREFRAME_ASSISTANT_PROVIDER=auto        # auto | local | anthropic
# WIREFRAME_ASSISTANT_SHARE_CONTEXT=1      # 0: never send the anonymised inspection summary
# Dataset curation only (ml/curate.py): YuNet ONNX model for the privacy screen
# WIREFRAME_YUNET=models/face_detection_yunet_2023mar.onnx
